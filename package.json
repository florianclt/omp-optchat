{
  "name": "pi-optchat",
  "version": "0.8.2",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --import ./test/support.ts --test test/*.test.ts",
    "test:live": "tsx test/live.ts"
  },
  "devDependencies": {
    "@oh-my-pi/pi-agent-core": "18.8.7",
    "@oh-my-pi/pi-ai": "18.8.7",
    "@oh-my-pi/pi-coding-agent": "18.8.7",
    "@oh-my-pi/pi-tui": "18.8.7",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-agent-core": "*",
    "@oh-my-pi/pi-ai": "*",
    "@oh-my-pi/pi-coding-agent": "*",
    "@oh-my-pi/pi-tui": "*",
    "typebox": "*"
  },
  "description": "OptChat memory for oh-my-pi (omp): persistent profiles, zoomable history, background agents, and conversation imports. Fork of pi-optchat.",
  "keywords": [
    "omp-plugin",
    "optchat",
    "uniichat",
    "memory",
    "subagents"
  ],
  "author": "Jonas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonaslsaa/pi-optchat.git"
  },
  "homepage": "https://github.com/jonaslsaa/pi-optchat#readme",
  "bugs": {
    "url": "https://github.com/jonaslsaa/pi-optchat/issues"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "files": [
    "src",
    "docs/*.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "omp": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/jonaslsaa/pi-optchat/main/docs/banner.jpg"
  }
